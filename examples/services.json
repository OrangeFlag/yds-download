{
  "speed_targets_mbit_s": {"download": 90, "upload": 90},
  "repo": "/home/USER/gitRepos/yds-download",
  "state_dir": "/home/USER/.local/state/yds-download",
  "mount_root": "/run/media/USER/DISK",
  "disk_uuid": "00000000-0000-0000-0000-000000000000",
  "previous_mounts": [],
  "course_queue": "$mount_root/YandexDisk/.download/semester-queue/queue.json",
  "queue_tuning": {
    "download_concurrency": 4,
    "connections": 4,
    "split": 4,
    "timeout": 30,
    "range_workers": 2,
    "range_rps": 5
  },
  "environment": {},
  "properties": {
    "MemoryMax": "infinity",
    "MemoryHigh": "infinity",
    "MemorySwapMax": "infinity",
    "TasksMax": "18321"
  },
  "services": {
    "queue": {
      "command": [
        "python3",
        "$repo/semester_queue.py",
        "$mount_root/YandexDisk/.download/semester-queue/queue.json",
        "--defer-range",
        "--range-budget",
        "$mount_root/YandexDisk/.download/http-budget",
        "--range-files",
        "16",
        "--nextcloud-fallback",
        "https://NEXTCLOUD/index.php/s/READ_SHARE",
        "--opencloud-fallback",
        "https://OPENCLOUD",
        "--opencloud-username",
        "USER",
        "--opencloud-password-file",
        "$home/.config/yds-download/opencloud.token",
        "--download-budget",
        "$state_dir/download-budget",
        "--download-min-files",
        "2",
        "--download-max-files",
        "8"
      ]
    },
    "range": {
      "command": [
        "python3",
        "$repo/range_queue.py",
        "--queue",
        "$mount_root/YandexDisk/Личный Яндекс Диск/.download/personal-queue.json",
        "--queue",
        "$mount_root/YandexDisk/.download/semester-queue/queue.json",
        "--files",
        "16",
        "--secondary-slots",
        "8",
        "--requests-per-file",
        "2",
        "--requests",
        "12",
        "--rps",
        "5",
        "--budget",
        "$mount_root/YandexDisk/.download/http-budget",
        "--nextcloud-fallback",
        "https://NEXTCLOUD/index.php/s/READ_SHARE",
        "--recheck-interval",
        "86400",
        "--recheck-files",
        "8",
        "--recheck-probes",
        "16",
        "--recheck-full-interval",
        "604800",
        "--opencloud-fallback",
        "https://OPENCLOUD",
        "--opencloud-username",
        "USER",
        "--opencloud-password-file",
        "$home/.config/yds-download/opencloud.token",
        "--download-budget",
        "$state_dir/download-budget",
        "--download-min-files",
        "2",
        "--download-max-files",
        "8"
      ],
      "properties": {
        "MemoryMax": "3221225472",
        "MemoryHigh": "2684354560",
        "MemoryAccounting": "yes"
      }
    },
    "nextcloud": {
      "command": [
        "/usr/bin/python3",
        "$repo/nextcloud.py",
        "--queue",
        "$mount_root/YandexDisk/.download/semester-queue/queue.json",
        "--nextcloud-existing",
        "https://NEXTCLOUD/index.php/s/READ_SHARE",
        "--nextcloud-upload",
        "https://NEXTCLOUD/index.php/s/UPLOAD_SHARE",
        "--nickname",
        "USER",
        "--transfers",
        "8",
        "--min-transfers",
        "2",
        "--upload-budget",
        "$state_dir/upload-budget"
      ]
    },
    "opencloud": {
      "command": [
        "/usr/bin/python3",
        "$repo/opencloud.py",
        "--queue",
        "$mount_root/YandexDisk/.download/semester-queue/queue.json",
        "--destination",
        "$mount_root/YandexDisk/ШАД весна 2026",
        "--server",
        "https://OPENCLOUD",
        "--username",
        "USER",
        "--password-file",
        "$home/.config/yds-download/opencloud.token",
        "--upload",
        "--transfers",
        "8",
        "--poll-interval",
        "300",
        "--min-transfers",
        "2",
        "--upload-budget",
        "$state_dir/upload-budget"
      ]
    }
  }
}
